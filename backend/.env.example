# Django
SECRET_KEY=your-secret-key-here-change-in-production
DJANGO_SETTINGS_MODULE=config.settings.development

# Database (production only — dev uses SQLite)
DATABASE_URL=postgres://user:password@localhost:5432/mediaflow

# CORS (production)
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
CORS_ALLOWED_ORIGINS=https://yourdomain.com

# Email
DEFAULT_FROM_EMAIL=noreply@mediaflow.io
EMAIL_HOST=smtp.sendgrid.net
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=your-sendgrid-api-key

# SMS (optional — set SMS_BACKEND to Twilio to enable)
SMS_BACKEND=apps.notifications.sms.backends.console.ConsoleSMSBackend
# SMS_BACKEND=apps.notifications.sms.backends.console.TwilioSMSBackend
SMS_FROM_NUMBER=+15550000000
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# S3 File Storage (optional)
USE_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=mediaflow-files
AWS_S3_REGION_NAME=us-east-1
